// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- CORE PAYEASE MODELS ---

model Merchant {
  id               BigInt   @id @default(autoincrement())
  name             String
  category         String?
  icon             String?
  credit_limit     Decimal?
  plan_description String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@map("merchants")
}

model Pool {
  id                  BigInt   @id @default(autoincrement())
  name                String
  tvl                 Decimal  @default(0)
  apr                 Decimal  @default(0)
  utilization         Decimal  @default(0)
  available_liquidity Decimal  @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("pools")
}

model Limit {
  id            BigInt   @id @default(autoincrement())
  current_limit Decimal  @default(0)
  used          Decimal  @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("limits")
}

model Transaction {
  id          BigInt   @id @default(autoincrement())
  title       String
  amount      Decimal
  asset       String   @default("USDC")
  category    String?
  status      String   @default("pending")
  tx_hash     String?
  user_id     String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  hub_tx_hash String?
  chain_id    BigInt?
  user_address String?

  @@map("transactions")
}

model Deposit {
  id            BigInt   @id @default(autoincrement())
  tx_hash       String   @unique
  hub_tx_hash   String?
  user_address  String?
  amount        Decimal?
  token_address String?
  chain_key     BigInt?  @default(1)
  status        String?  @default("PENDING")
  proof         Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("deposits")
}

model BridgeTransaction {
  id              BigInt   @id @default(autoincrement())
  source_tx_hash  String   @unique
  hub_tx_hash     String?
  user_address    String?
  amount          Decimal?
  token_address   String?
  source_chain_id BigInt?
  dest_chain_id   BigInt?
  status          String?  @default("COMPLETED")
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("bridge_transactions")
}

// --- POLARIS DEVELOPER CONSOLE ---

model MerchantUser {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_address String   @unique
  email          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  apps           MerchantApp[]

  @@map("merchant_users")
}

model MerchantApp {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  name            String
  description     String?
  logo_url        String?
  category        String?
  client_id       String   @unique @default(dbgenerated("md5((random())::text || (clock_timestamp())::text)::uuid"))
  client_secret   String   @default(dbgenerated("encode(gen_random_bytes(32), 'hex')"))
  escrow_contract String?
  network         String?  @default("creditcoin_testnet")
  status          String?  @default("active")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  user     MerchantUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  api_keys ApiKey[]
  webhooks Webhook[]

  @@map("merchant_apps")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app_id       String    @db.Uuid
  key_hash     String
  label        String?
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  app MerchantApp @relation(fields: [app_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Webhook {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app_id     String   @db.Uuid
  url        String
  secret     String
  events     String[]
  is_active  Boolean? @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  logs       WebhookLog[]

  app MerchantApp @relation(fields: [app_id], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model WebhookLog {
  id              BigInt   @id @default(autoincrement())
  webhook_id      String   @db.Uuid
  event_type      String
  payload         Json
  response_status Int?
  response_body   String?
  attempt_count   Int?     @default(1)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}
